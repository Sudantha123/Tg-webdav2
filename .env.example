# ─────────── Telegram ───────────
# Bot token from @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From https://my.telegram.org → "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# Target channel id (bot must be admin). Format: -100xxxxxxxxxx
# Tip: forward a channel post to @userinfobot / @getidsbot to get it.
CHANNEL_ID=-1001234567890

# Folder where inbox uploads land (changeable later from the web UI)
DEFAULT_FOLDER=general

# (optional) only these telegram user ids may use the bot. Empty = everyone.
# ALLOWED_USER_IDS=123456789,987654321

# ─────────── Server / login ───────────
PORT=8080
WEB_USER=admin
WEB_PASS=changeme
# (optional) extra logins: WEB_USERS=user1:pass1,user2:pass2
# WEB_USERS=

# ─────────── Storage / performance ───────────
DATA_DIR=./data
CACHE_MB=64          # RAM chunk cache
PREFETCH=8           # 1MiB blocks read ahead (video seek smoothness)
DELETE_FROM_TELEGRAM=true

LOG_LEVEL=info
